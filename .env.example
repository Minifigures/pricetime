# Copy to .env.local (gitignored) for local development, and set the same
# variable in the Vercel project settings for the deployed site.
#
# Only the narrative stage uses this. The engine, the surveillance detectors
# and every number on the page are computed in C++ and WebAssembly and never
# call out to anything. With none of these set the site still works: the
# detections are complete, and the panel says plainly that the write-up stage
# is off.
#
# Set ONE of these. The route uses the first it finds, free tiers first.

# aistudio.google.com/apikey, free, no card, and the shortest path to a key.
# Sign in with a Google account and create one. Uses gemini-3.5-flash-lite.
GEMINI_API_KEY=

# openrouter.ai, free, no card. Sign in, create a key, and turn on the free
# model toggle at openrouter.ai/settings/privacy or free models return 404.
# Uses z-ai/glm-5.2:free. 50 requests a day on the free tier.
OPENROUTER_API_KEY=

# z.ai, glm-4.7-flash is priced at zero rather than trial credit.
ZAI_API_KEY=

# huggingface.co, router. Roughly ten cents of credit a month, so this is a
# third option rather than a real one.
HF_TOKEN=

# Paid. Only used if none of the above are set.
ANTHROPIC_API_KEY=
